# RAFT-LM training environment (v0.2 — training only)

# Experiment logging: local | wandb | comet
EXPERIMENT_BACKEND=local
WANDB_PROJECT=raft-lm
COMET_PROJECT_NAME=raft-lm

# Model paths (optional)
RAFT_MODELS_ROOT=
RAFT_ADAPTERS_ROOT=experiments/adapters
RAFT_ALLOW_LARGE_MODELS=0

# Results
RAFT_RESULTS_DIR=experiments/results

# Distributed (optional)
# RANK=0
# WORLD_SIZE=1
# MASTER_ADDR=localhost
# MASTER_PORT=29500

# RunPod / container override
# RUNPOD_RUN_DIR=/workspace/experiments/current
