# RAFT-LM benchmark and demo (local only — not production SaaS)

# Model provider and models
MODEL_PROVIDER=stub
EMBEDDING_MODEL=deterministic-stub
GENERATION_MODEL=deterministic-stub

# Retrieval budget (identical for Standard RAG and RAFT-LM)
MAX_RETRIEVAL_DEPTH=4
MAX_CONTEXT_CHARS=4096
BENCHMARK_RUN_COUNT=1

# Ragas
BENCHMARK_MODE=stub
RAGAS_API_KEY=
OPENAI_API_KEY=

# Paths
BENCHMARK_RESULTS_DIR=docs/benchmarks/results

# Optional live Ragas (set BENCHMARK_MODE=live and provide API keys)
# RAGAS_METRICS=context_precision,faithfulness
