# RAFT-LM benchmark and demo (local only — not production SaaS)

# Model provider and models
MODEL_PROVIDER=stub

# Embedding: mock (CI default) | live (requires API keys)
EMBEDDING_MODE=mock
EMBEDDING_MODEL=deterministic-stub
# Live OpenAI default when EMBEDDING_MODE=live and OPENAI_API_KEY is set:
# EMBEDDING_MODEL=text-embedding-3-small

# Enterprise Azure OpenAI (when EMBEDDING_MODE=live)
# EMBEDDING_MODEL=azure:text-embedding-3-small
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# AZURE_OPENAI_API_VERSION=2024-02-01

# Self-hosted OpenAI-compatible embeddings
# EMBEDDING_MODEL=compatible:text-embedding-3-small
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:8080/v1

GENERATION_MODEL=deterministic-stub
VECTOR_STORE=in_memory
# Optional: faiss | qdrant (requires faiss-cpu or qdrant-client)
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=raft_lm_benchmark

# Retrieval budget (identical for Standard RAG and RAFT-LM)
MAX_RETRIEVAL_DEPTH=4
MAX_CONTEXT_CHARS=4096
BENCHMARK_RUN_COUNT=1

# Ragas / benchmark harness
BENCHMARK_MODE=stub
RAGAS_API_KEY=
OPENAI_API_KEY=

# Paths
BENCHMARK_RESULTS_DIR=docs/benchmarks/results

# Optional live Ragas (set BENCHMARK_MODE=live and provide API keys)
# RAGAS_METRICS=context_precision,faithfulness

# Manual smoke (not run in CI): EMBEDDING_MODE=live BENCHMARK_MODE=live python scripts/run_benchmark.py --mode live
